{
  "proxyMode": "dimse",

  // DIMSE proxy settings with TLS enabled
  "dimseProxySettings": {
    "proxyServer": {
      "aet": "DICOM_WEB_PROXY_TLS",
      "ip": "0.0.0.0",
      "port": 8889,
      // TLS security options using test certificates
      "securityOptions": {
        "key": "/app/cert-test/dicom/server.key",
        "cert": "/app/cert-test/dicom/server.crt",
        "ca": "/app/cert-test/dicom/ca.crt",
        "requestCert": true,
        "rejectUnauthorized": false, // For testing with self-signed certs
        "minVersion": "TLSv1.2",
        "maxVersion": "TLSv1.3"
      }
    },
    "peers": [
      {
        "aet": "ORTHANC",
        "ip": "orthanc",
        "port": 4242
      }
    ]
  },
  "storagePath": "/tmp/dicomweb-proxy-tls",
  "cacheRetentionMinutes": 60,
  "enableCache": false,
  "webserverPort": 3006,
  "useCget": true,
  "qidoMinChars": 0,
  "qidoAppendWildcard": true,
  "ssl": {
    "enabled": false,
    "port": 443,
    "certPath": "/app/cert-test/localhost+1.pem",
    "keyPath": "/app/cert-test/localhost+1-key.pem",
    "generateSelfSigned": false,
    "redirectHttp": false
  },
  "cors": {
    "origin": ["*"],
    "methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
    "allowedHeaders": ["Content-Type", "Authorization", "Accept"],
    "credentials": true
  }
}